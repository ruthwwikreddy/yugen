rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /registrations/{registrationId} {
      allow read, delete: if true;
      allow create: if request.resource.data.keys().hasAll([
          'name', 'email', 'phone', 'school', 'grade', 'experience', 'amount', 'tier', 'status'
        ])
        && request.resource.data.status == 'pending'
        && (
          (request.resource.data.tier == 'internal' && request.resource.data.amount == 1000) ||
          (request.resource.data.tier == 'external' && request.resource.data.amount == 1200) ||
          (request.resource.data.tier == 'early-bird' && request.resource.data.amount == 1200)
        );
      allow update: if true;
    }
    match /oc_applications/{applicationId} {
      allow read, delete: if true;
      allow create: if request.resource.data.keys().hasAll([
          'name', 'email', 'phone', 'school', 'grade', 'roleId', 'status'
        ])
        && request.resource.data.status == 'pending';
      allow update: if true;
    }
  }
}
