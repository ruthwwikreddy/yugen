rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /registrations/{registrationId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll([
          'name', 'email', 'phone', 'school', 'grade', 'experience', 'amount', 'tier', 'status'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.tier == 'early-bird'
        && request.resource.data.amount == 1200;
      // Admin dashboard uses client-side password — tighten with Firebase Auth for production
      allow update: if request.resource.data.status in ['pending', 'paid', 'verified', 'rejected'];
      allow delete: if true;
    }
  }
}
